# Shared Postgres instance used by both microservices (see infra/postgres-init).
# Copy this file to ".env" and fill in real values before running
# `docker compose up`. Each app also keeps its own env file:
#   task-verifier/backend/.env.examples
#   tambo/backend/.env.example
#   tambo/frontend/.env.example

# Superuser the "db" container itself starts with (used only to run the
# init script that creates the two app-specific roles/databases below —
# neither app connects to Postgres with these credentials).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# task-verifier's own role + database inside the shared instance.
# Must match task-verifier/backend/.env's DATABASE_URL.
TASK_VERIFIER_DB_USER=taskuser
TASK_VERIFIER_DB_PASSWORD=taskpassword
TASK_VERIFIER_DB_NAME=task_verifier

# tambo's own role + database inside the shared instance.
# Must match tambo/backend/.env's DATABASE_URL.
TAMBO_DB_USER=cami
TAMBO_DB_PASSWORD=cami
TAMBO_DB_NAME=cami
