FROM node:20-slim AS builder

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Vite inlinea import.meta.env.VITE_API_URL en el bundle AL COMPILAR, no en
# runtime — por eso tiene que llegar como build arg acá, no como variable
# de entorno normal del contenedor final. En Railway: Settings > Variables
# de este servicio, declarada igual (Railway la reenvía como build arg
# automáticamente porque el nombre coincide con este ARG).
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '$PORT' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
