# Postgres
POSTGRES_USER=cami
POSTGRES_PASSWORD=cami
POSTGRES_DB=cami

# Backend
DATABASE_URL=postgresql+psycopg2://cami:cami@db:5432/cami
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend
# Use 127.0.0.1 instead of localhost if your machine resolves "localhost" to
# the IPv6 loopback and Docker Desktop only forwards ports on IPv4.
VITE_API_URL=http://127.0.0.1:8000

# To open the app from a phone on the same WiFi network:
# 1. Find this PC's LAN IP (Windows: `Get-NetIPAddress -AddressFamily IPv4`,
#    look for the Wi-Fi interface, e.g. 192.168.1.50).
# 2. Add "http://<that-ip>:5173" to CORS_ORIGINS above.
# 3. Set VITE_API_URL=http://<that-ip>:8000
# 4. Allow inbound TCP 5173/8000 on the Private firewall profile (admin
#    PowerShell): New-NetFirewallRule -DisplayName "AppCami frontend LAN"
#    -Direction Inbound -Protocol TCP -LocalPort 5173 -Action Allow -Profile Private
# 5. docker compose up -d --build backend frontend
# 6. Open http://<that-ip>:5173 on the phone.
