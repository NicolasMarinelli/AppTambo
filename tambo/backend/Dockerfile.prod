FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Railway asigna el puerto en tiempo de ejecución vía $PORT (no es fijo
# como en local) — a diferencia de task-verifier/backend/Dockerfile.prod,
# acá SÍ lo usamos dinámicamente (forma shell del CMD para que ${PORT}
# se expanda). Sin --reload en producción.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
