# laboratorio NO tiene base de datos propia: se conecta a la misma base de
# tambo ("cami" por defecto) con un rol de Postgres propio que solo puede
# leer (SELECT) la tabla users de tambo, y es dueño exclusivo de su propio
# esquema "laboratorio" dentro de esa misma base (tipos_analisis,
# fotos_referencia, resultados_laboratorio). Ver, en la raíz del repo:
#   - infra/postgres-init/init-multiple-dbs.sh (crea el rol + el esquema)
#   - .env.example (LABORATORIO_DB_USER / LABORATORIO_DB_PASSWORD)
# Usuario/contraseña acá deben coincidir con esas variables de raíz.
DATABASE_URL=postgresql+psycopg2://laboratorio:laboratorio@db:5432/cami

# DEBE ser exactamente el mismo valor que JWT_SECRET_KEY en
# tambo/backend/.env. Es lo que permite que un token emitido al loguearse
# en tambo sirva también acá (y viceversa) sin tener que loguearse de
# nuevo — mismo esquema de JWT, mismo secreto.
JWT_SECRET_KEY=copia-el-mismo-valor-que-tambo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:5175"]

# Mismo proveedor que ya usa task-verifier para fotos (ver
# task-verifier/backend/.env.examples) — reusar esa cuenta con un folder
# distinto ("laboratorio/...") o crear una cuenta nueva, cualquiera sirve.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mismo proveedor de IA que ya usa task-verifier (ver ia_service.py ahí).
# Puede ser la misma API key de Anthropic que usa esa app, o una separada
# si querés trackear consumo por servicio.
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001
